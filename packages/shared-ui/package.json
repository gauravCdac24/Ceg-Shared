{
  "name": "@ceg/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable React form fields and UI primitives (Alert, Toast, Modal, Button, EmptyState, ErrorBoundary) for every Ceg frontend.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ceg/design-tokens": ">=0.1.0",
    "framer-motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7.50.0",
    "sonner": ">=2.0.0"
  },
  "dependencies": {
    "@ceg/shared-validation": "workspace:*",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@ceg/design-tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ceg/design-tokens": "workspace:*",
    "framer-motion": "^12.38.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "typescript": "^5.5.0"
  }
}
