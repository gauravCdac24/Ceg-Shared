{
  "name": "@ceg/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe API client (openapi-fetch) for every Ceg backend, generated from docs/api-contracts/*/openapi.json.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ceg-core": {
      "types": "./dist/ceg-core/index.d.ts",
      "import": "./dist/ceg-core/index.js"
    },
    "./ceg-gateway": {
      "types": "./dist/ceg-gateway/index.d.ts",
      "import": "./dist/ceg-gateway/index.js"
    },
    "./notification": {
      "types": "./dist/notification/index.d.ts",
      "import": "./dist/notification/index.js"
    },
    "./workshopos": {
      "types": "./dist/workshopos/index.d.ts",
      "import": "./dist/workshopos/index.js"
    },
    "./quizforge": {
      "types": "./dist/quizforge/index.d.ts",
      "import": "./dist/quizforge/index.js"
    },
    "./cert-studio": {
      "types": "./dist/cert-studio/index.d.ts",
      "import": "./dist/cert-studio/index.js"
    },
    "./fetchdesk": {
      "types": "./dist/fetchdesk/index.d.ts",
      "import": "./dist/fetchdesk/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ceg/shared-validation": "workspace:*",
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "jsdom": "^25.0.0"
  }
}
