{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "fixtures/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "auth"]
}
