{
  "name": "@ceg/shared-validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas + validators (phone, pincode, PAN, GST, Aadhaar, anti-spam) used by every Ceg frontend.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./data/states-cities": {
      "types": "./dist/data/states-cities.d.ts",
      "import": "./dist/data/states-cities.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "libphonenumber-js": "^1.11.0",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
